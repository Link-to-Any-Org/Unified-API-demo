# LinkToAny Unified API (@linktoany/sdk) credentials.
LINKTOANY_API_KEY=
LINKTOANY_ORGANISATION_ID=
# 'dev' -> api.staging.linktoany.com, 'prod' -> api.linktoany.com
LINKTOANY_ENVIRONMENT=dev

# Square's systemId within the Unified API. Leave blank and run
# `npm run linktoany:discover` to find it automatically once the above are set.
LINKTOANY_SQUARE_SYSTEM_ID=

# Where the Unified API should send the merchant back after OAuth.
LINKTOANY_RETURN_URL=https://your-domain.example.com/api/square/callback

# Random string (32+ chars) used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Payment writes are OFF unless this is exactly "true". Off: placing an order
# creates the Square order only. On: it also writes an immediately captured,
# non-refundable (simulated cash) payment - only enable against a disposable
# Square account.
ENABLE_PAYMENT_WRITES=false

# Optional: an HTTPS tunnel hostname (e.g. from `npx ngrok http 3000`) to
# allow for local dev, beyond localhost. Leave blank if you don't use one.
DEV_TUNNEL_ORIGIN=
