# LinkToAny Unified API (@linktoany/sdk) credentials.
LINKTOANY_API_KEY=
LINKTOANY_ORGANISATION_ID=
# 'dev' -> api.staging.linktoany.com, 'prod' -> api.linktoany.com
LINKTOANY_ENVIRONMENT=dev

# The system (integration) this deployment connects to. This is the only thing
# to change to point the app at another system: its name, how it connects and
# which screens apply are all discovered from it. Leave blank and run
# `npm run linktoany:discover` to list the systems on the platform and find the
# id. (Older setups used LINKTOANY_SQUARE_SYSTEM_ID, which still works.)
LINKTOANY_SYSTEM_ID=

# Optional: name of the credential set ("application") to connect through.
# Recommended when your organisation has more than one set for the system -
# otherwise LinkToAny chooses one itself. (Older name:
# LINKTOANY_SQUARE_APPLICATION, still accepted.)
LINKTOANY_APPLICATION=

# Required for every system. Its origin is the app's public address, which
# every redirect is built from; for systems with a hosted consent screen it
# is also where the Unified API sends the merchant back after OAuth, so it
# must then match the credential set's registered return URL.
LINKTOANY_RETURN_URL=https://your-domain.example.com/api/connect/callback

# Random string (32+ chars) used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Payment writes are OFF unless this is exactly "true". Off: placing an order
# creates the order only. On: it also writes an immediately captured,
# non-refundable (simulated cash) payment - only enable against a disposable
# account. Ignored for systems that have no payment write.
ENABLE_PAYMENT_WRITES=false

# Optional: an extra hostname to allow as a Next dev origin. The host of
# LINKTOANY_RETURN_URL (e.g. your ngrok tunnel) is already allowed
# automatically, so this is only needed for an additional host.
DEV_TUNNEL_ORIGIN=
