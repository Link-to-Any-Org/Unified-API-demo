# LinkToAny Unified API (@linktoany/sdk) credentials.
UNIFLOW_API_KEY=
UNIFLOW_ORGANISATION_ID=
# 'dev' -> api.staging.linktoany.com, 'prod' -> api.linktoany.com
UNIFLOW_ENVIRONMENT=dev

# Square's systemId within the Unified API, and the application slug its
# integration is registered under. Leave blank and run
# `npm run uniflow:discover` to find both automatically once the above are set.
UNIFLOW_SQUARE_SYSTEM_ID=
UNIFLOW_SQUARE_APPLICATION=

# Where the Unified API should send the merchant back after OAuth.
UNIFLOW_RETURN_URL=https://your-domain.example.com/api/square/callback

# Random string (32+ chars) used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
