# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code: only the shared dev-server launch config is tracked; personal
# state (settings.local.json) and the app's worktrees/ stay local.
.claude/*
!.claude/launch.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Postman environment files hold the API key once filled in locally
*.postman_environment.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
